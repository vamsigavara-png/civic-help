# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helphub?schema=public"

# Security
JWT_SECRET="change-me-to-a-long-random-secret-in-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Optional: Object Storage (wire before production)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# S3_BUCKET="helphub-evidence"

# Optional: Reverse Geocoding
# GEOCODING_API_KEY=""

# Optional: Email (for notifications)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
