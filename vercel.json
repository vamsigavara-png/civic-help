{
  "buildCommand": "npx prisma migrate deploy && npm run build",
  "env": {
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "JWT_SECRET": {
      "description": "JWT signing secret (use strong random value)",
      "required": true
    },
    "NEXT_PUBLIC_APP_URL": {
      "description": "Public app URL",
      "required": true
    }
  },
  "framework": "nextjs",
  "functions": {
    "api/**": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
